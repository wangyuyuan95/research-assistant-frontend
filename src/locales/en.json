  "examples": {
    "quickStarts": "Quick Starts",
    "mofsDrugRelease": {
      "title": "Recent Breakthroughs in MOFs Structural Optimization for Controlled Drug Release",
      "query": "Analyze breakthrough advancements in metal-organic frameworks (MOFs) for drug delivery systems over the past three years, focusing on optimization strategies for porosity and drug loading efficiency."
    },
    "plgaBBBModification": {
      "title": "Functionalization Strategies for Enhancing PLGA Nanoparticle Blood-Brain Barrier Penetration",
      "query": "How can surface functionalization modify poly(lactic-co-glycolic acid) (PLGA) nanoparticles to improve blood-brain barrier penetration efficiency? Compare preclinical data of physical versus chemical modification approaches."
    },
    "hydrogelImmunotherapy": {
      "title": "Mechanisms and Efficacy Evaluation of Smart Hydrogels in Synergistic Cancer Immunotherapy",
      "query": "Systematically summarize the synergistic mechanisms and animal model efficacy of tumor microenvironment-responsive smart hydrogels in combined immunotherapy (e.g., PD-1/CTLA-4 inhibitors)."
    },
    "crisprOffTargetControl": {
      "title": "Advances in Off-Target Effect Control for CRISPR-Cas9 DMD Therapy (2020-Present)",
      "query": "Review off-target risk mitigation strategies in CRISPR-Cas9 gene editing for Duchenne muscular dystrophy (DMD) treatment, emphasizing in vivo experimental data since 2020."
    },
    "adcLinkerPayload": {
      "title": "Linker-Payload Technological Breakthroughs in HER2-Targeted ADC Drugs for Overcoming Resistance",
      "query": "Analyze design innovations and pharmacokinetic advantages of linker-payload systems in third-generation antibody-drug conjugates (ADCs) like T-DXd addressing HER2-positive breast cancer drug resistance."
    },
    "aiPeptideAssembly": {
      "title": "Limitations and Applications of AI-Driven Models for Peptide Self-Assembly Prediction",
      "query": "How can artificial intelligence predict self-assembly behavior of peptide-based drugs? Evaluate reliability boundaries of deep learning models (e.g., AlphaFold-derived architectures) in this field."
    },
    "implantAntibacterialTech": {
      "title": "Translational Medicine Assessment: Metallic Coatings vs Biodegradable Polymers for Orthopedic Implant Antibacterial Technologies",
      "query": "Compare cost, biocompatibility, and clinical translation challenges between metallic implant antibacterial coatings (e.g., silver-coated titanium) and degradable antibacterial polymers (e.g., PDA-PEG) for orthopedic infection prevention."
    },
    "organChipToxicity": {
      "title": "Industrial Validation and Application of Organ-on-a-Chip Models in Drug Hepatotoxicity Assessment",
      "query": "How can organ-on-a-chip models replace traditional animal testing in drug hepatotoxicity prediction? Provide cross-pharmaceutical company validation case studies."
    },
    "mrnaVaccineDelivery": {
      "title": "Delivery Bottlenecks and Process Optimization Pathways for mRNA-LNP Cancer Vaccines",
      "query": "Demonstrate key challenges in mRNA-LNP delivery systems for neoantigen vaccine development, including carrier stability, dendritic cell targeting efficiency, and lyophilization process feasibility."
    },
    "cryoemGpcrdynamics": {
      "title": "Cryo-EM Driven Dynamic Conformational Analysis of GPCR-Nanobody Complexes for Drug Design",
      "query": "How can cryo-electron microscopy (Cryo-EM) resolve dynamic conformations of G protein-coupled receptor (GPCR)-nanobody complexes? Elucidate implications for allosteric inhibitor design."
    }
  },
